# Configuration des API PISTE (https://piste.gouv.fr/)
# Copier ce fichier vers .env et remplir avec vos identifiants

# Mode : "production" ou "sandbox" (défaut: production)
PISTE_MODE=production

# Identifiants API PISTE Production (OAuth 2.0)
# Obtenus après inscription sur https://piste.gouv.fr/
PISTE_CLIENT_ID=votre_client_id_production_ici
PISTE_CLIENT_SECRET=votre_client_secret_production_ici

# Identifiants API PISTE Sandbox (pour les tests)
PISTE_SANDBOX_CLIENT_ID=votre_client_id_sandbox_ici
PISTE_SANDBOX_CLIENT_SECRET=votre_client_secret_sandbox_ici
